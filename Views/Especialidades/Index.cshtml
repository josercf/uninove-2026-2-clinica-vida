@model IEnumerable<ClinicaVida.Web.Models.Especialidade>

@{
    ViewData["Title"] = "Especialidades";
    var contagem = ViewBag.ContagemMedicos as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<h2>Especialidades</h2>

<ul class="list-group">
    @foreach (var esp in Model)
    {
        int qtd = contagem.ContainsKey(esp.Id) ? contagem[esp.Id] : 0;
        
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                <strong>@esp.Nome</strong> - @esp.Descricao
            </div>
            <div>
                <a asp-controller="Medicos" asp-action="Index" asp-route-especialidadeId="@esp.Id" class="badge bg-primary rounded-pill text-decoration-none">
                    @qtd médico(s)
                </a>
            </div>
        </li>
    }
</ul>